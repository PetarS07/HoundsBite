<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="HoundsBite.Views.UserPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:HoundsBite.Controls"
             BackgroundColor="#121212">

    <Grid RowDefinitions="*, Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="25"
                                 Padding="30,30,30,0"
                                 VerticalOptions="Start">

                <!-- Title -->
                <Label x:Name="PageTitle"
                       Text="Login"
                       FontSize="32"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="White" />

                <!-- GUEST VIEW: Login Form -->
                <VerticalStackLayout x:Name="LoginView" Spacing="15" VerticalOptions="Center" Margin="0,50,0,0">
                    <Entry x:Name="LoginUsernameEntry"
                           Placeholder="Email Address"
                           TextColor="White"
                           PlaceholderColor="#888"
                           BackgroundColor="#1E1E1E" />

                    <Entry x:Name="LoginPasswordEntry"
                           IsPassword="True"
                           Placeholder="Password"
                           TextColor="White"
                           PlaceholderColor="#888"
                           BackgroundColor="#1E1E1E" />

                    <Button Text="Login"
                            Clicked="OnLoginClicked"
                            Margin="0,10,0,0" />

                    <Label Text="Don't have an account?"
                           HorizontalOptions="Center"
                           TextColor="#888"
                           Margin="0,10,0,0" />

                    <Button Text="Create Account"
                            Clicked="OnRegisterClicked"
                            Style="{StaticResource SecondaryButton}" />
                </VerticalStackLayout>

                <!-- LOGGED IN VIEW: Profile Settings -->
                <VerticalStackLayout x:Name="ProfileView"
                                     Spacing="25"
                                     IsVisible="False">

                    <Frame BackgroundColor="#1E1E1E"
                           CornerRadius="100"
                           HeightRequest="100"
                           WidthRequest="100"
                           HorizontalOptions="Center"
                           BorderColor="{StaticResource Primary}"
                           Padding="0">
                        <Label Text="👤"
                               FontSize="50"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Frame>

                    <Label x:Name="WelcomeLabel"
                           Text="Welcome back!"
                           FontSize="20"
                           HorizontalOptions="Center"
                           TextColor="{StaticResource TextSecondary}" />

                    <!-- Account Details Section -->
                    <Frame BackgroundColor="#1E1E1E" CornerRadius="12" Padding="20">
                        <VerticalStackLayout Spacing="15">
                            <Label Text="Account Details" FontSize="18" FontAttributes="Bold" TextColor="White" />
                            
                            <!-- Email ReadOnly -->
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Email Address" TextColor="#888" FontSize="12" />
                                <Label x:Name="ReadOnlyEmailLabel" Text="user@example.com" TextColor="White" FontSize="16" />
                            </VerticalStackLayout>

                            <BoxView HeightRequest="1" Color="#333" />

                            <!-- Display Name Editable -->
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Display Name (Username)" TextColor="#888" FontSize="12" />
                                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                                    <Entry x:Name="DisplayNameEntry" 
                                           Grid.Column="0" 
                                           Placeholder="Set a username..." 
                                           TextColor="White" 
                                           BackgroundColor="#252525"
                                           TextChanged="OnDisplayNameTextChanged"/>
                                    <Button x:Name="SaveDisplayNameButton" 
                                            Grid.Column="1" 
                                            Text="Save" 
                                            Padding="10,0"
                                            Clicked="OnSaveDisplayNameClicked"/>
                                </Grid>
                                
                                <!-- Username Requirements -->
                                <Label x:Name="UsernameReqToggle" 
                                       Text="Requirements" 
                                       TextColor="DeepSkyBlue" 
                                       TextDecorations="Underline" 
                                       FontSize="12"
                                       IsVisible="False">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnUsernameReqTapped"/>
                                    </Label.GestureRecognizers>
                                </Label>

                                <VerticalStackLayout x:Name="UsernameReqPanel" IsVisible="False" Spacing="2" Margin="5,0,0,0">
                                    <Label x:Name="ReqUserLength" Text="• 3 to 20 characters" FontSize="12" TextColor="Red"/>
                                    <Label x:Name="ReqUserChars" Text="• Only letters, numbers, and underscores" FontSize="12" TextColor="Red"/>
                                </VerticalStackLayout>
                            </VerticalStackLayout>

                        </VerticalStackLayout>
                    </Frame>

                    <!-- Change Password Section -->
                    <Frame BackgroundColor="#1E1E1E" CornerRadius="12" Padding="20">
                        <VerticalStackLayout Spacing="15">
                            <Label Text="Change Password" FontSize="18" FontAttributes="Bold" TextColor="White" />
                            
                            <Entry x:Name="OldPasswordEntry" Placeholder="Current Password" IsPassword="True" TextColor="White" BackgroundColor="#252525" />
                            
                            <VerticalStackLayout Spacing="4">
                                <Entry x:Name="NewPasswordEntry" Placeholder="New Password" IsPassword="True" TextColor="White" BackgroundColor="#252525" TextChanged="OnPasswordTextChanged" />
                                
                                <!-- Password Requirements -->
                                <Label x:Name="PasswordReqToggle" 
                                       Text="Requirements" 
                                       TextColor="DeepSkyBlue" 
                                       TextDecorations="Underline" 
                                       FontSize="12"
                                       IsVisible="False">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnPasswordReqTapped"/>
                                    </Label.GestureRecognizers>
                                </Label>

                                <VerticalStackLayout x:Name="PasswordReqPanel" IsVisible="False" Spacing="2" Margin="5,0,0,0">
                                    <Label x:Name="ReqLength" Text="• Minimum 8 characters" FontSize="12" TextColor="Red"/>
                                    <Label x:Name="ReqUpper" Text="• At least one uppercase letter" FontSize="12" TextColor="Red"/>
                                    <Label x:Name="ReqLower" Text="• At least one lowercase letter" FontSize="12" TextColor="Red"/>
                                    <Label x:Name="ReqNumber" Text="• At least one number" FontSize="12" TextColor="Red"/>
                                    <Label x:Name="ReqSpecial" Text="• At least one special character" FontSize="12" TextColor="Red"/>
                                </VerticalStackLayout>
                            </VerticalStackLayout>

                            <Entry x:Name="ConfirmPasswordEntry" Placeholder="Confirm New Password" IsPassword="True" TextColor="White" BackgroundColor="#252525" TextChanged="OnConfirmPasswordTextChanged" />
                            <Label x:Name="ConfirmPasswordError" Text="Passwords do not match" TextColor="Red" FontSize="12" IsVisible="False" />

                            <Button x:Name="ChangePasswordButton" Text="Change Password" Clicked="OnChangePasswordClicked" BackgroundColor="#8B0000" TextColor="White" Margin="0,10,0,0" />
                        </VerticalStackLayout>
                    </Frame>

                    <Button Text="Logout"
                            Clicked="OnLogoutClicked"
                            Style="{StaticResource SecondaryButton}"
                            BackgroundColor="#333"
                            Margin="0,10,0,0"/>

                </VerticalStackLayout>

                <!-- Bottom spacing so content clears the NavBar -->
                <BoxView HeightRequest="100" Color="Transparent"/>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Custom Nav Bar -->
        <controls:NavBar Grid.Row="1" ActiveTab="Profile" Margin="0,-80,0,0"/>

    </Grid>
</ContentPage>
