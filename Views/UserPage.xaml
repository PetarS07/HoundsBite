<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="HoundsBite.Views.UserPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             BackgroundColor="#121212">

    <ScrollView>
        <VerticalStackLayout Spacing="25" 
                             Padding="30" 
                             VerticalOptions="Center">

            <!-- Title -->
            <Label x:Name="PageTitle"
                   Text="Login"
                   FontSize="32"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="White" />

            <!-- GUEST VIEW: Login Form -->
            <VerticalStackLayout x:Name="LoginView" Spacing="15">
                <Entry x:Name="UsernameEntry"
                       Placeholder="Username"
                       TextColor="White"
                       PlaceholderColor="#888"
                       BackgroundColor="#1E1E1E" />
                
                <Entry x:Name="PasswordEntry"
                       IsPassword="True"
                       Placeholder="Password"
                       TextColor="White"
                       PlaceholderColor="#888"
                       BackgroundColor="#1E1E1E" />

                <Button Text="Login"
                        Clicked="OnLoginClicked"
                        Margin="0,10,0,0" />

                <Label Text="Don't have an account?"
                       HorizontalOptions="Center"
                       TextColor="#888"
                       Margin="0,10,0,0" />
                
                <Button Text="Create Account"
                        Clicked="OnRegisterClicked"
                        Style="{StaticResource SecondaryButton}" />
            </VerticalStackLayout>


            <!-- LOGGED IN VIEW: Profile -->
            <VerticalStackLayout x:Name="ProfileView" 
                                 Spacing="20" 
                                 IsVisible="False">
                
                <Frame BackgroundColor="#1E1E1E" 
                       CornerRadius="100" 
                       HeightRequest="120" 
                       WidthRequest="120"
                       HorizontalOptions="Center"
                       BorderColor="{StaticResource Primary}">
                    <Label Text="👤" 
                           FontSize="50" 
                           HorizontalOptions="Center" 
                           VerticalOptions="Center"/>
                </Frame>

                <Label x:Name="WelcomeLabel"
                       Text="Welcome back!"
                       FontSize="20"
                       HorizontalOptions="Center"
                       TextColor="{StaticResource TextSecondary}" />

                <Button Text="Logout"
                        Clicked="OnLogoutClicked"
                        Style="{StaticResource SecondaryButton}"
                        BackgroundColor="#333" 
                        Margin="0,20,0,0"/>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
