<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="HoundsBite.Views.RecipeDetailPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Recipe Details">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="24">
            
            <!-- Back Button -->
            <Button Text="← Back to Recipes"
                    Clicked="OnBackClicked"
                    HorizontalOptions="Start"
                    HeightRequest="36"
                    FontSize="12"
                    Style="{StaticResource SecondaryButton}"/>

            <!-- Recipe Header -->
            <VerticalStackLayout Spacing="8">
                <HorizontalStackLayout Spacing="12">
                    <Label x:Name="TypeIcon" 
                           FontSize="40" 
                           VerticalOptions="Center"/>
                    <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                        <Label x:Name="RecipeName" 
                               Style="{StaticResource HeaderLabel}"
                               FontSize="28"/>
                        <Label x:Name="RecipeType" 
                               TextColor="{StaticResource Primary}" 
                               FontSize="14" 
                               FontAttributes="Bold"/>
                    </VerticalStackLayout>
                </HorizontalStackLayout>
                
                <Label x:Name="RecipeDescription" 
                       TextColor="{StaticResource TextSecondary}"
                       FontSize="14"
                       Margin="0,8,0,0"/>
            </VerticalStackLayout>

            <!-- Quick Info Cards -->
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                <!-- Prep Time -->
                <Border Style="{StaticResource CardView}" Padding="12">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="⏱️" FontSize="20" HorizontalOptions="Center"/>
                        <Label x:Name="PrepTimeLabel" 
                               FontSize="12" 
                               FontAttributes="Bold"
                               HorizontalOptions="Center"/>
                        <Label Text="Prep" 
                               FontSize="10" 
                               TextColor="{StaticResource TextSecondary}"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Cook Time -->
                <Border Style="{StaticResource CardView}" Padding="12" Grid.Column="1">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="🔥" FontSize="20" HorizontalOptions="Center"/>
                        <Label x:Name="CookTimeLabel" 
                               FontSize="12" 
                               FontAttributes="Bold"
                               HorizontalOptions="Center"/>
                        <Label Text="Cook" 
                               FontSize="10" 
                               TextColor="{StaticResource TextSecondary}"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Servings -->
                <Border Style="{StaticResource CardView}" Padding="12" Grid.Column="2">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="🍽️" FontSize="20" HorizontalOptions="Center"/>
                        <Label x:Name="ServingsLabel" 
                               FontSize="12" 
                               FontAttributes="Bold"
                               HorizontalOptions="Center"/>
                        <Label Text="Servings" 
                               FontSize="10" 
                               TextColor="{StaticResource TextSecondary}"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Difficulty -->
                <Border Style="{StaticResource CardView}" Padding="12" Grid.Column="3">
                    <VerticalStackLayout Spacing="4">
                        <Label x:Name="DifficultyIcon" FontSize="20" HorizontalOptions="Center"/>
                        <Label x:Name="DifficultyLabel" 
                               FontSize="12" 
                               FontAttributes="Bold"
                               HorizontalOptions="Center"/>
                        <Label Text="Level" 
                               FontSize="10" 
                               TextColor="{StaticResource TextSecondary}"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Ingredients Section -->
            <Border Style="{StaticResource CardView}" Padding="20">
                <VerticalStackLayout Spacing="12">
                    <Label Text="📋 Ingredients" 
                           Style="{StaticResource CardTitle}"
                           FontSize="20"/>
                    <BoxView HeightRequest="1" Color="{StaticResource CardBackgroundLight}" />
                    
                    <CollectionView x:Name="IngredientsList">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto,*" Padding="0,6" ColumnSpacing="12">
                                    <Label Text="•" 
                                           FontSize="16" 
                                           TextColor="{StaticResource Primary}"
                                           VerticalOptions="Start"
                                           Margin="0,2,0,0"/>
                                    <Label Grid.Column="1" 
                                           FontSize="14"
                                           LineBreakMode="WordWrap">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding AmountWithUnit}" 
                                                      FontAttributes="Bold"
                                                      TextColor="{StaticResource Primary}"/>
                                                <Span Text=" "/>
                                                <Span Text="{Binding Name}"/>
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <!-- Instructions Section -->
            <Border Style="{StaticResource CardView}" Padding="20">
                <VerticalStackLayout Spacing="12">
                    <Label Text="👨‍🍳 Instructions" 
                           Style="{StaticResource CardTitle}"
                           FontSize="20"/>
                    <BoxView HeightRequest="1" Color="{StaticResource CardBackgroundLight}" />
                    
                    <Label x:Name="InstructionsLabel" 
                           FontSize="14"
                           LineBreakMode="WordWrap"
                           TextColor="{StaticResource TextPrimary}"/>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
