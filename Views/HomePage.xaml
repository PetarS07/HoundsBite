<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="HoundsBite.Views.HomePage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             BackgroundColor="#121212">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <Label Text="Hound’s Bite"
                   FontSize="34"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="White" />

            <Label x:Name="UserStatusLabel"
                   Text="Not logged in"
                   HorizontalOptions="Center"
                   TextColor="White"
                   FontSize="14" />

            <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                <Button x:Name="LoginButton"
                        Text="Login / Register"
                        Clicked="OpenLogin"
                        BackgroundColor="#555"
                        TextColor="White" />

                <Button x:Name="LogoutButton"
                        Text="Logout"
                        Clicked="OnLogoutClicked"
                        BackgroundColor="#8B0000"
                        TextColor="White"
                        IsVisible="False" />
            </HorizontalStackLayout>

            <!-- Admin-only pages -->
            <VerticalStackLayout Spacing="8" Margin="0,20,0,0">
                <Button x:Name="AdminIngredientsButton"
                        Text="Manage Ingredients (Admin)"
                        Clicked="GoToIngredients"
                        BackgroundColor="#2E8B57"
                        TextColor="White"
                        IsVisible="False" />

                <Button x:Name="AdminRecipesButton"
                        Text="Manage Recipes (Admin)"
                        Clicked="GoToRecipes"
                        BackgroundColor="#2E8B57"
                        TextColor="White"
                        IsVisible="False" />
            </VerticalStackLayout>

            <!-- Public pages -->
            <VerticalStackLayout Spacing="8" Margin="0,20,0,0">
                <Button Text="View Ingredients"
                        Clicked="GoToDisplayIngredients"
                        BackgroundColor="#444"
                        TextColor="White" />

                <Button Text="View Recipes"
                        Clicked="GoToDisplayRecipes"
                        BackgroundColor="#444"
                        TextColor="White" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
