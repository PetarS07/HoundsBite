<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="HoundsBite.Views.RegisterPopup"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             BackgroundColor="#80000000">

    <Frame VerticalOptions="Center"
           HorizontalOptions="Center"
           Padding="20"
           BackgroundColor="#1E1E1E"
           CornerRadius="12"
           WidthRequest="320">

        <VerticalStackLayout Spacing="15">

            <Label Text="Register"
                   FontSize="24"
                   HorizontalOptions="Center"
                   TextColor="White"/>

            <VerticalStackLayout Spacing="4">
                <Entry x:Name="EmailEntry"
                       Placeholder="Email"
                       TextColor="White"
                       TextChanged="OnEmailTextChanged"/>
                <Label x:Name="EmailErrorLabel"
                       Text="Example: example@email.com"
                       TextColor="Red"
                       FontSize="12"
                       IsVisible="False" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Entry x:Name="PasswordEntry"
                       Placeholder="Password"
                       IsPassword="True"
                       TextColor="White"
                       TextChanged="OnPasswordTextChanged"/>
                
                <Label Text="Requirements" 
                       TextColor="DeepSkyBlue" 
                       TextDecorations="Underline" 
                       FontSize="12">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnRequirementsTapped"/>
                    </Label.GestureRecognizers>
                </Label>

                <VerticalStackLayout x:Name="RequirementsPanel" IsVisible="False" Spacing="2" Margin="5,0,0,0">
                    <Label x:Name="ReqLength" Text="• Minimum 8 characters" FontSize="12" TextColor="Red"/>
                    <Label x:Name="ReqUpper" Text="• At least one uppercase letter" FontSize="12" TextColor="Red"/>
                    <Label x:Name="ReqLower" Text="• At least one lowercase letter" FontSize="12" TextColor="Red"/>
                    <Label x:Name="ReqNumber" Text="• At least one number" FontSize="12" TextColor="Red"/>
                    <Label x:Name="ReqSpecial" Text="• At least one special character" FontSize="12" TextColor="Red"/>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <Button x:Name="RegisterButton"
                    Text="Create Account"
                    BackgroundColor="#8B0000"
                    TextColor="White"
                    Clicked="OnRegisterClicked"/>

            <Button Text="Close"
                    BackgroundColor="#444"
                    TextColor="White"
                    Clicked="OnCloseClicked"/>
        </VerticalStackLayout>
    </Frame>

</ContentPage>
