<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="HoundsBite.Views.AdminPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:HoundsBite.Controls"
             xmlns:models="clr-namespace:HoundsBite.Models"
             BackgroundColor="#121212">

    <Grid RowDefinitions="Auto, *, Auto">
        <!-- Header -->
        <VerticalStackLayout Padding="20,40,20,10" Spacing="5">
            <Label Text="Admin Dashboard" 
                   TextColor="White" 
                   FontSize="28" 
                   FontAttributes="Bold"/>
            <Label Text="Manage community recipes and submissions" 
                   TextColor="#888888" 
                   FontSize="14"/>
        </VerticalStackLayout>

        <!-- Main Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="20">
                


                <BoxView HeightRequest="1" Color="#2A2A2A" Margin="0,10"/>

                <Label Text="Quick Links" 
                       TextColor="White" 
                       FontSize="20" 
                       FontAttributes="Bold"/>
                
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Button Text="Manage Ingredients" 
                            Clicked="OnManageIngredientsClicked"
                            BackgroundColor="#1E1E1E"
                            TextColor="White"
                            BorderColor="#2A2A2A"
                            BorderWidth="1"
                            HeightRequest="80"/>
                    <Button Grid.Column="1" 
                            Text="Manage All Recipes" 
                            Clicked="OnManageRecipesClicked"
                            BackgroundColor="#1E1E1E"
                            TextColor="White"
                            BorderColor="#2A2A2A"
                            BorderWidth="1"
                            HeightRequest="80"/>
                </Grid>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Navigation Placeholder -->
        <controls:NavBar Grid.Row="2" ActiveTab="Admin"/>
    </Grid>
</ContentPage>
