<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="HoundsBite.Views.RecipesPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Recipes">

    <VerticalStackLayout Padding="16" Spacing="16">
        
        <!-- Header -->
        <Grid ColumnDefinitions="Auto, *" Margin="0,0,0,10">
            <Button Text="&lt; Back" 
                    Clicked="OnBackClicked"
                    Style="{StaticResource SecondaryButton}"
                    HeightRequest="36"
                    FontSize="12"
                    HorizontalOptions="Start" 
                    VerticalOptions="Center" />

            <Label Text="Manage Recipes" 
                   Style="{StaticResource HeaderLabel}"
                   FontSize="20"
                   Grid.Column="1"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   Margin="-60,0,0,0"/>
        </Grid>

        <ScrollView>
            <VerticalStackLayout Spacing="16">

            <Entry x:Name="RecipeName" Placeholder="Recipe name" />
            <Picker x:Name="RecipeType" Title="Select Type">
                <Picker.Items>
                    <x:String>Breakfast</x:String>
                    <x:String>Lunch</x:String>
                    <x:String>Dinner</x:String>
                    <x:String>Other</x:String>
                </Picker.Items>
            </Picker>
            <Editor x:Name="RecipeDesc" Placeholder="Description" />

            <Label Text="Select ingredients:" FontAttributes="Bold" />

            <!-- List of ingredients with checkboxes -->
            <CollectionView x:Name="IngredientSelector">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <HorizontalStackLayout>
                            <CheckBox IsChecked="{Binding IsSelected}" />
                            <Label Text="{Binding Name}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Text="Add Recipe" Clicked="OnAddRecipe" />

            <CollectionView x:Name="RecipeList">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <VerticalStackLayout Padding="10">
                            <Label Text="{Binding Name}" FontAttributes="Bold"/>
                            <Label Text="{Binding Type}"/>
                            <Label Text="{Binding Description}"/>
                            <Label Text="Ingredients:" FontAttributes="Bold"/>
                            <Label Text="{Binding IngredientNames}"/>

                            <HorizontalStackLayout>
                                <Button Text="Edit" CommandParameter="{Binding .}" Clicked="OnEditRecipe"/>
                                <Button Text="Delete" CommandParameter="{Binding .}" Clicked="OnDeleteRecipe"/>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
    </VerticalStackLayout>
</ContentPage>