<ContentPage x:Class="HoundsBite.Views.DisplayRecipesPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:HoundsBite.Controls"
             Title="Recipes List">

    <Grid RowDefinitions="*, Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="24,24,24,0" Spacing="24">

                <!-- Header -->
                <Label Text="Discover Recipes"
                       Style="{StaticResource HeaderLabel}"/>

                <!-- Search Bar -->
                <Border Style="{StaticResource CardView}" Padding="0" Margin="0,0,0,4">
                    <SearchBar x:Name="SearchBar"
                               Placeholder="Find your next meal..."
                               TextChanged="OnSearchTextChanged"
                               BackgroundColor="Transparent"/>
                </Border>

                <!-- Filters Section -->
                <Border Style="{StaticResource CardView}" Padding="16" Margin="0,0,0,8">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="Filters" Style="{StaticResource CardTitle}" VerticalOptions="Center"/>
                            <Label Text="Config" FontSize="12" TextColor="{StaticResource TextTertiary}" VerticalOptions="Center" Grid.Column="1"/>
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource CardBackgroundLight}" />

                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="Category" VerticalOptions="Center" TextColor="{StaticResource TextSecondary}"/>
                            <Picker Grid.Column="1"
                                    x:Name="CategoryFilter"
                                    SelectedIndexChanged="OnCategoryFilterChanged"
                                    WidthRequest="150"
                                    BackgroundColor="Transparent"
                                    TextColor="{StaticResource Primary}">
                                <Picker.Items>
                                    <x:String>All</x:String>
                                    <x:String>Breakfast</x:String>
                                    <x:String>Lunch</x:String>
                                    <x:String>Dinner</x:String>
                                    <x:String>Other</x:String>
                                </Picker.Items>
                            </Picker>
                        </Grid>

                        <Grid x:Name="FilterToggleContainer" ColumnDefinitions="*, Auto">
                            <Label Text="Can make now" VerticalOptions="Center" TextColor="{StaticResource TextSecondary}"/>
                            <Switch Grid.Column="1" x:Name="FilterToggle" Toggled="OnFilterToggled" />
                        </Grid>

                        <!-- NEW: Favorites Only Filter -->
                        <Grid x:Name="FavoritesToggleContainer" ColumnDefinitions="*, Auto" IsVisible="False">
                            <Label Text="Favorites Only" VerticalOptions="Center" TextColor="{StaticResource TextSecondary}"/>
                            <Switch Grid.Column="1" x:Name="FavoritesToggle" Toggled="OnFavoritesToggled" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Recipes List -->
                <CollectionView x:Name="RecipeList">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="12" VerticalItemSpacing="12" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardView}" Padding="16" HeightRequest="120">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnRecipeTapped" CommandParameter="{Binding Id}"/>
                                </Border.GestureRecognizers>
                                <Grid RowDefinitions="*, Auto">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                                            <Label Text="{Binding Name}"
                                                   Style="{StaticResource CardTitle}"
                                                   MaxLines="2"
                                                   LineBreakMode="TailTruncation"/>
                                            <Label Text="{Binding Type}"
                                                   TextColor="{StaticResource Primary}"
                                                   FontSize="11"
                                                   FontAttributes="Bold"/>
                                        </VerticalStackLayout>
                                        
                                        <!-- NEW: Favorite Star Button -->
                                        <Label Grid.Column="1"
                                               Text="{Binding FavoriteIcon}"
                                               FontSize="20"
                                               VerticalOptions="Start">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnFavoriteTapped" CommandParameter="{Binding Id}"/>
                                            </Label.GestureRecognizers>
                                        </Label>
                                    </Grid>
                                    
                                    <Label Grid.Row="1"
                                           Text="👉 Tap to view"
                                           FontSize="10"
                                           TextColor="{StaticResource TextSecondary}"
                                           HorizontalOptions="End"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Bottom spacing so content clears the NavBar -->
                <BoxView HeightRequest="90" Color="Transparent"/>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Custom Nav Bar -->
        <controls:NavBar Grid.Row="1" ActiveTab="Recipes" Margin="0,-80,0,0"/>

    </Grid>
</ContentPage>
