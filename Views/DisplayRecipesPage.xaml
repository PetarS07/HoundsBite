<ContentPage x:Class="HoundsBite.Views.DisplayRecipesPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Recipes List">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="24">
            
            <!-- Header -->
            <!-- Header -->
            <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,16">
                <Label Text="Discover Recipes" 
                       Style="{StaticResource HeaderLabel}"
                       VerticalOptions="Center"/>
                <Button Text="Back to Home"
                        Clicked="OnBackClicked"
                        Grid.Column="1"
                        HeightRequest="36"
                        FontSize="12"
                        VerticalOptions="Center"/>
            </Grid>

            <!-- Search Bar -->
            <Border Style="{StaticResource CardView}" Padding="0" Margin="0,0,0,12">
                <SearchBar x:Name="SearchBar" 
                          Placeholder="Find your next meal..." 
                          TextChanged="OnSearchTextChanged"
                          BackgroundColor="Transparent"/>
            </Border>

            <!-- Filters Section -->
            <Border Style="{StaticResource CardView}" Padding="16" Margin="0,0,0,16">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Filters" Style="{StaticResource CardTitle}" VerticalOptions="Center"/>
                        <Label Text="Config" FontSize="12" TextColor="{StaticResource TextTertiary}" VerticalOptions="Center" Grid.Column="1"/>
                    </Grid>
                    
                    <BoxView HeightRequest="1" Color="{StaticResource CardBackgroundLight}" />

                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Category" VerticalOptions="Center" TextColor="{StaticResource TextSecondary}"/>
                        <Picker Grid.Column="1" 
                                x:Name="CategoryFilter" 
                                SelectedIndexChanged="OnCategoryFilterChanged"
                                WidthRequest="150"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource Primary}">
                            <Picker.Items>
                                <x:String>All</x:String>
                                <x:String>Breakfast</x:String>
                                <x:String>Lunch</x:String>
                                <x:String>Dinner</x:String>
                                <x:String>Other</x:String>
                            </Picker.Items>
                        </Picker>
                    </Grid>
                        
                    <Grid x:Name="FilterToggleContainer" ColumnDefinitions="*, Auto">
                        <Label Text="Can make now" VerticalOptions="Center" TextColor="{StaticResource TextSecondary}"/>
                        <Switch Grid.Column="1" x:Name="FilterToggle" Toggled="OnFilterToggled" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Recipes List -->
            <CollectionView x:Name="RecipeList">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="12" VerticalItemSpacing="12" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardView}" Padding="16" HeightRequest="120">
                            <Grid RowDefinitions="*, Auto">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding Name}" 
                                           Style="{StaticResource CardTitle}"
                                           MaxLines="2"
                                           LineBreakMode="TailTruncation"/>
                                    <Label Text="{Binding Type}" 
                                           TextColor="{StaticResource Primary}" 
                                           FontSize="11" 
                                           FontAttributes="Bold"/>
                                </VerticalStackLayout>
                                
                                <Label Grid.Row="1" 
                                       Text="View Details" 
                                       FontSize="10" 
                                       TextColor="{StaticResource TextSecondary}"
                                       HorizontalOptions="End"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
