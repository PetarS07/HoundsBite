<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="HoundsBite.Views.DisplayIngredientsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:HoundsBite.Controls"
             Title="Ingredients">

    <Grid RowDefinitions="*, Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="24,24,24,0" Spacing="24">

                <!-- Tab Switcher -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,-12,0,4">
                    <Button x:Name="TabMyKitchen"
                            Text="My Kitchen"
                            Clicked="OnTabMyKitchenClicked"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="8"
                            HeightRequest="40"
                            BorderWidth="1"
                            BorderColor="{StaticResource Primary}"/>
                    <Button x:Name="TabSearch"
                            Grid.Column="1"
                            Text="Search &amp; Add"
                            Clicked="OnTabSearchClicked"
                            BackgroundColor="#1E1E1E"
                            TextColor="{StaticResource Primary}"
                            BorderColor="{StaticResource Primary}"
                            BorderWidth="1"
                            FontAttributes="Bold"
                            CornerRadius="8"
                            HeightRequest="40" />
                </Grid>

                <Label Text="Kitchen inventory"
                       Style="{StaticResource HeaderLabel}" IsVisible="False"/>

                <Label x:Name="HelpText"
                       Text="Manage the ingredients you currently have in your kitchen."
                       TextColor="{StaticResource TextSecondary}"
                       Margin="0,-16,0,0"/>

                <Border x:Name="SearchPanel" Style="{StaticResource CardView}" Padding="0" Margin="0,0,0,8" IsVisible="False">
                    <SearchBar x:Name="SearchBar"
                               Placeholder="Search ingredients…"
                               TextChanged="OnSearchTextChanged"
                               SearchButtonPressed="OnSearchButtonPressed"
                               BackgroundColor="Transparent"/>
                </Border>

                <ActivityIndicator x:Name="ApiLoadingIndicator"
                                   IsRunning="False"
                                   IsVisible="False"
                                   Color="{StaticResource Primary}"
                                   HorizontalOptions="Center"
                                   Margin="0,20"/>

                <CollectionView x:Name="IngredientList">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="12" VerticalItemSpacing="12" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardView}" Padding="12" MinimumHeightRequest="180">
                                <Grid RowDefinitions="Auto, Auto">
                                    <VerticalStackLayout Spacing="8" VerticalOptions="Start">
                                        <Image Source="{Binding ImageUrl}"
                                               HeightRequest="60"
                                               WidthRequest="60"
                                               HorizontalOptions="Center"
                                               IsVisible="{Binding HasImage}"
                                               Aspect="AspectFit" />
                                        <Label Text="{Binding Name}"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               LineBreakMode="WordWrap"
                                               MaxLines="2"
                                               HorizontalOptions="Center"
                                               HorizontalTextAlignment="Center"/>
                                    </VerticalStackLayout>

                                    <Grid Grid.Row="1" ColumnDefinitions="*, Auto" ColumnSpacing="6" Margin="0,8,0,0">
                                        <Button Text="{Binding KitchenButtonText}"
                                                BackgroundColor="{Binding KitchenButtonColor}"
                                                TextColor="White"
                                                FontSize="11"
                                                HeightRequest="34"
                                                CornerRadius="8"
                                                Padding="4,0"
                                                CommandParameter="{Binding .}"
                                                Clicked="OnKitchenToggleClicked"
                                                IsEnabled="{Binding IsLoggedIn}" />

                                        <Button Grid.Column="1"
                                                Text="Delete"
                                                Style="{StaticResource SecondaryButton}"
                                                FontSize="11"
                                                HeightRequest="34"
                                                Padding="10,0"
                                                CommandParameter="{Binding .}"
                                                Clicked="OnDeleteClicked"
                                                IsVisible="{Binding ShowDeleteButton}" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <BoxView HeightRequest="160" Color="Transparent"/>
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="1" RowDefinitions="Auto,Auto" Margin="0,-80,0,0">

            <Border x:Name="AddPanelContainer" Grid.Row="0"
                    BackgroundColor="#1A1A1A"
                    StrokeThickness="0"
                    IsVisible="False">
                <VerticalStackLayout Spacing="0">
                    <Button x:Name="AddPanelToggle"
                            Text="＋ Add product"
                            Clicked="OnAddPanelToggle"
                            BackgroundColor="#252525"
                            TextColor="{StaticResource Primary}"
                            FontSize="13"
                            HeightRequest="40"
                            CornerRadius="0" />

                    <VerticalStackLayout x:Name="AddIngredientForm"
                                         IsVisible="False"
                                         Spacing="8"
                                         Padding="16,10,16,12">
                        <Entry x:Name="NewIngredientEntry"
                               Placeholder="Name"
                               TextColor="White"
                               PlaceholderColor="#888"
                               BackgroundColor="#252525" />
                        <Button Text="Add to catalog and kitchen"
                                Clicked="OnAddIngredientClicked"
                                HeightRequest="36"
                                FontSize="13" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <controls:NavBar Grid.Row="1" ActiveTab="Ingredients" />
        </Grid>

    </Grid>
</ContentPage>
