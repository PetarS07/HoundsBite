<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Premium Dark Theme Palette -->
    
    <!-- Brand Colors -->
    <Color x:Key="Primary">#7C4DFF</Color> <!-- Vibrant Violet -->
    <Color x:Key="PrimaryDark">#651FFF</Color>
    <Color x:Key="Secondary">#03DAC6</Color> <!-- Teal Accent -->
    <Color x:Key="Accent">#FF4081</Color>    <!-- Pink Accent -->

    <!-- Backgrounds -->
    <Color x:Key="PageBackground">#101010</Color> <!-- Deep Black -->
    <Color x:Key="CardBackground">#1E1E1E</Color> <!-- Dark Grey -->
    <Color x:Key="CardBackgroundLight">#2D2D2D</Color>

    <!-- Text -->
    <Color x:Key="TextPrimary">#FFFFFF</Color>
    <Color x:Key="TextSecondary">#B0B0B0</Color>
    <Color x:Key="TextTertiary">#757575</Color>

    <!-- Status -->
    <Color x:Key="Success">#00E676</Color>
    <Color x:Key="Error">#FF5252</Color>
    <Color x:Key="Warning">#FFAB40</Color>

    <!-- Compatibility Keys (Mapping new palette to old keys if needed, or ensuring they exist) -->
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="PageBackgroundBrush" Color="{StaticResource PageBackground}"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackground}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}"/>
    
</ResourceDictionary>