<?xml version="1.0" encoding="utf-8" ?>
<Shell x:Class="HoundsBite.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:HoundsBite.Views"
       BackgroundColor="#121212"
       ForegroundColor="White">

    
    <ShellContent Route="home"
                  Title="Home"
                  ContentTemplate="{DataTemplate views:HomePage}" />

    
    <ShellContent Route="ingredients"
                  Title="Ingredients"
                  ContentTemplate="{DataTemplate views:IngredientsPage}" />

     
    <ShellContent Route="recipes"
                  Title="Recipes"
                  ContentTemplate="{DataTemplate views:RecipesPage}" />

    <ShellContent Route="display-ingredients" ContentTemplate="{DataTemplate views:DisplayIngredientsPage}" />
    <ShellContent Route="display-recipes" ContentTemplate="{DataTemplate views:DisplayRecipesPage}" />

</Shell>