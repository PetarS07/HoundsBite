<?xml version="1.0" encoding="utf-8" ?>
<Shell x:Class="HoundsBite.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:HoundsBite.Views"
       BackgroundColor="#121212"
       ForegroundColor="White">

    <!-- HOME -->
    <ShellContent Route="home"
                  Title="Home"
                  ContentTemplate="{DataTemplate views:HomePage}" />

    <!-- INGREDIENTS -->
    <ShellContent Route="ingredients"
                  Title="Ingredients"
                  ContentTemplate="{DataTemplate views:IngredientsPage}" />

    <!-- RECIPES -->
    <ShellContent Route="recipes"
                  Title="Recipes"
                  ContentTemplate="{DataTemplate views:RecipesPage}" />

</Shell>